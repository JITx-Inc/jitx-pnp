# Ignore all hidden files/folders by default
.*

# Whitelist specific dotfiles/folders
!.gitignore
!.github/

# Python virtual environments
.venv/
venv/
env/

# Python bytecode and cache
__pycache__/
*.pyc
*.pyo

# Build artifacts
build/
dist/
*.egg-info/
*.egg

# Test / lint / type-check caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
htmlcov/
.coverage
coverage.xml

# Editor / OS junk
.DS_Store
*.swp
*.swo
*.bak

# JITX runtime state and caches for any design built in this checkout
designs/
parts-db/
